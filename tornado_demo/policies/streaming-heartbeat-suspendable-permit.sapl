policy "streaming-heartbeat-suspendable-permit"
permit
  action == "stream:heartbeat";
  resource == "heartbeat-suspendable";
  var second = time.secondOf(<time.now>);
  second >= 0 && second < 20 || second >= 40;
obligation
  {
    "type": "logAccess",
    "message": "Suspendable heartbeat permitted"
  }
